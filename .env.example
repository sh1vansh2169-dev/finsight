# FinSight configuration. Copy the values you need into your environment;
# never commit a real .env file. All settings are optional.

# "real" (default) or "sample". A database is stamped with its mode on first
# use and refuses to open in the other mode, so sample and real data never mix.
MONEYOS_DATA_MODE=real

# SQLAlchemy URL. Relative SQLite paths are resolved from the directory the
# server is started in (the repo root in the documented workflow).
# Defaults: sqlite:///data/moneyos.db (real), sqlite:///data/sample/moneyos-sample.db (sample)
MONEYOS_DATABASE_URL=

# After the first account exists, more people can sign up only if this is
# true. Set passwords and add accounts locally with `moneyos user ...`.
MONEYOS_ALLOW_SIGNUP=false

# Where trained models are saved and loaded. Default: data/models
MONEYOS_MODELS_DIR=

# Path to your own copy of backend/src/moneyos/domain/default_rules.toml.
MONEYOS_RULES_FILE=

# Folder with the built web app (npm run build). Default: frontend/dist
MONEYOS_FRONTEND_DIST=

# Statement inbox: statements saved in this folder are staged for review. Off when empty.
MONEYOS_WATCH_DIR=
# Whose ledger the inbox fills (needed only when there is more than one account).
MONEYOS_WATCH_USER=

# Fetch statements and alert emails from Gmail into the inbox every 30 minutes
# (after `moneyos gmail connect`). The searches use Gmail search syntax.
MONEYOS_GMAIL_FETCH=false
MONEYOS_GMAIL_STATEMENTS=
MONEYOS_GMAIL_ALERTS=

# The assistant's local model server (Ollama) and model. Defaults shown.
MONEYOS_OLLAMA_URL=
MONEYOS_ASSISTANT_MODEL=
# The model reads your money data. Only a server on this computer is used unless this is true.
MONEYOS_ASSISTANT_ALLOW_REMOTE=false
