# MoneyOS configuration. Copy the values you need into your environment;
# never commit a real .env file. All settings are optional.

# "real" (default) or "sample". A database is stamped with its mode on first
# use and refuses to open in the other mode, so sample and real data never mix.
MONEYOS_DATA_MODE=real

# SQLAlchemy URL. Relative SQLite paths are resolved from the directory the
# server is started in (the repo root in the documented workflow).
# Defaults: sqlite:///data/moneyos.db (real), sqlite:///data/sample/moneyos-sample.db (sample)
MONEYOS_DATABASE_URL=

# When set, every /api/v1 request needs "Authorization: Bearer <token>".
# Required to listen on anything other than 127.0.0.1 / localhost.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MONEYOS_API_TOKEN=

# Path to your own copy of backend/src/moneyos/domain/default_rules.toml.
MONEYOS_RULES_FILE=
